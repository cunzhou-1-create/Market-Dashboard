# 数据库配置
DATABASE_URL="postgresql://user:password@localhost:5432/booking_db"

# 安全配置
SECRET_KEY="your-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 邮件配置
# 请使用真实的SMTP服务器配置
# 例如，使用QQ邮箱：
# EMAIL_HOST="smtp.qq.com"
# EMAIL_PORT=587
# EMAIL_USERNAME="your-qq-email@qq.com"
# EMAIL_PASSWORD="your-qq-email-authorization-code"  # QQ邮箱需要使用授权码而非密码
# EMAIL_FROM="your-qq-email@qq.com"
# 
# 例如，使用163邮箱：
# EMAIL_HOST="smtp.163.com"
# EMAIL_PORT=587
# EMAIL_USERNAME="your-163-email@163.com"
# EMAIL_PASSWORD="your-163-email-authorization-code"  # 163邮箱需要使用授权码而非密码
# EMAIL_FROM="your-163-email@163.com"
# 
# 例如，使用Gmail：
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT=587
# EMAIL_USERNAME="your-gmail-email@gmail.com"
# EMAIL_PASSWORD="your-gmail-app-password"  # Gmail需要使用应用专用密码
# EMAIL_FROM="your-gmail-email@gmail.com"
EMAIL_HOST="smtp.example.com"
EMAIL_PORT=587
EMAIL_USERNAME="your-email@example.com"
EMAIL_PASSWORD="your-email-password"
EMAIL_FROM="your-email@example.com"

# API配置
API_V1_STR="/api"
PROJECT_NAME="Crypto Booking API"

# 加密货币API配置
BINANCE_API_KEY="your-binance-api-key"
BINANCE_API_SECRET="your-binance-api-secret"

# 千问API配置
QWEN_API_KEY="your-qwen-api-key"

# AI交易配置
AI_TRADE_ENABLED=false
AI_TRADE_INTERVAL=30